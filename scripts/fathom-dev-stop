#!/usr/bin/env bash
# Stop Fathom development environment

FATHOM_DIR="/Users/alex/dev/fathom"

echo "Stopping Fathom dev environment..."

# Kill processes
echo "Killing puma..."
pkill -9 puma 2>/dev/null || true

pid_file="${FATHOM_DIR}/tmp/pids/server.pid"
if [[ -f ${pid_file} ]]; then
  pid=$(cat ${pid_file})
  if [[ -n ${pid} ]]; then
    echo "Killing leftover pid ${pid}"
    kill -9 "${pid}" 2>/dev/null || true
  fi
fi

# Kill sidekiq
echo "Killing sidekiq..."
pkill -9 sidekiq 2>/dev/null || true

# Kill node (stencil)
echo "Killing node processes..."
pkill -f "npm start" 2>/dev/null || true

# Kill ngrok
echo "Killing ngrok..."
pkill -9 ngrok 2>/dev/null || true

# Stop docker
echo "Stopping docker compose..."
cd "$FATHOM_DIR" && docker compose down

# Optionally stop colima
if which colima &>/dev/null; then
  read -p "Stop Colima? (y/N) " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    colima stop
  fi
fi

echo "Fathom dev environment stopped."
