#!/usr/bin/env python3
"""Render the current AeroSpace bindings.

Reads them from the running AeroSpace rather than parsing the TOML, so the sheet always matches
what is actually loaded. Writes an org file for Emacs and prints a plain-text version for the
popup terminal.
"""

import os
import subprocess
import sys

ORG_PATH = os.path.expanduser("~/dotfiles/aerospace/BINDINGS.org")

# Hyper lives on caps lock via Karabiner; showing the raw modifier list helps nobody.
HYPER = "cmd-ctrl-alt-shift-"

KEY_NAMES = {
    "quote": "'",
    "minus": "-",
    "equal": "=",
    "slash": "/",
    "semicolon": ";",
    "backtick": "`",
    "period": ".",
    "comma": ",",
    "leftSquareBracket": "[",
    "rightSquareBracket": "]",
}

SECTIONS = [
    ("Go to workspace", "Switches workspace and launches the app if it is not running."),
    ("Send window to workspace", "Moves the focused window and follows it there."),
    ("Focus", "Directional focus needs tiled windows; cycling works on floating ones too."),
    ("Move and resize", None),
    ("Layout", None),
    ("Modes", "Service mode runs one key then returns to normal on its own."),
    ("Other", None),
]


def aerospace(*args):
    return subprocess.run(
        ["aerospace", *args], capture_output=True, text=True, check=True
    ).stdout.strip()


def pretty_key(key):
    prefix = ""
    if key.startswith(HYPER):
        prefix, key = "caps-", key[len(HYPER):]
    elif key.startswith("alt-shift-"):
        prefix, key = "alt-shift-", key[len("alt-shift-"):]

    return prefix + KEY_NAMES.get(key, key)


def describe(value):
    """Turn a raw command string into something readable, and pick its section."""
    v = " ".join(value.split())

    if v.startswith("workspace "):
        target = v.split()[1].rstrip(",;")
        app = ""
        if "open -a" in v:
            app = v.split("open -a", 1)[1].strip().strip("'\"[]").strip()
        return "Go to workspace", f"workspace {target}" + (f"  ({app})" if app else "")

    if "move-node-to-workspace" in v:
        return "Send window to workspace", "-> workspace " + v.split()[-1]

    if v.startswith("focus") or "cycle-window" in v:
        if "cycle-window next" in v:
            return "Focus", "next window in this workspace, wraps"
        if "cycle-window prev" in v:
            return "Focus", "previous window in this workspace, wraps"
        if v == "focus-back-and-forth":
            return "Focus", "back to the last window you were on"
        return "Focus", "focus " + v.split()[-1]

    if v.startswith("move ") or v.startswith("resize "):
        return "Move and resize", v

    if v.startswith("layout") or v == "fullscreen" or v == "balance-sizes":
        return "Layout", v

    if v.startswith("mode "):
        return "Modes", f"enter {v.split()[1]} mode"

    return "Other", v


def collect(mode="main"):
    keys = aerospace("config", "--get", f"mode.{mode}.binding", "--keys").splitlines()
    grouped = {name: [] for name, _ in SECTIONS}

    for key in keys:
        key = key.strip()
        if not key:
            continue
        value = aerospace("config", "--get", f"mode.{mode}.binding.{key}")
        section, text = describe(value)
        grouped[section].append((pretty_key(key), text))

    for rows in grouped.values():
        rows.sort(key=lambda r: (len(r[0]), r[0]))

    return grouped


def render_text(grouped):
    out = ["", "  AeroSpace bindings", "  caps lock = hyper (tap alone for Escape)", ""]

    for name, note in SECTIONS:
        rows = grouped.get(name) or []
        if not rows:
            continue

        out.append(f"  {name.upper()}")
        if note:
            out.append(f"    {note}")
        for key, text in rows:
            out.append(f"    {key:<26} {text}")
        out.append("")

    out.append("  SERVICE MODE  caps-; then one key")
    for key, text in sorted((k, v) for k, v in service_rows()):
        out.append(f"    {key:<26} {text}")

    return "\n".join(out)


def service_rows():
    keys = aerospace("config", "--get", "mode.service.binding", "--keys").splitlines()
    for key in keys:
        key = key.strip()
        if not key or key.startswith("ctrl-"):
            continue
        value = aerospace("config", "--get", f"mode.service.binding.{key}")
        value = " ".join(value.split())
        for tail in ("; mode main", ", mode main"):
            value = value.replace(tail, "")
        value = value.strip("[]").strip()
        yield pretty_key(key), value


def render_org(grouped):
    out = [
        "#+TITLE: AeroSpace Bindings",
        "#+STARTUP: showall",
        "",
        "Generated by ~scripts/aerospace-cheatsheet~ from the running AeroSpace. Do not edit by hand.",
        "",
        "Caps lock is the hyper key, shown here as ~caps-~. Tapped alone it sends Escape.",
        "",
    ]

    for name, note in SECTIONS:
        rows = grouped.get(name) or []
        if not rows:
            continue

        out.append(f"* {name}")
        if note:
            out += [note, ""]
        out += org_table(rows)

    out.append("* Service mode")
    out += ["Press ~caps-;~ then one of these. It returns to normal mode on its own.", ""]
    out += org_table(sorted(service_rows()))

    return "\n".join(out)


def org_table(rows):
    """Emit an org table with padded columns so it reads correctly before Emacs realigns it."""
    cells = [(f"~{key}~", text) for key, text in rows]
    key_width = max([len("Key")] + [len(c[0]) for c in cells])
    text_width = max([len("Does")] + [len(c[1]) for c in cells])

    lines = [
        f"| {'Key':<{key_width}} | {'Does':<{text_width}} |",
        f"|{'-' * (key_width + 2)}+{'-' * (text_width + 2)}|",
    ]
    lines += [f"| {k:<{key_width}} | {t:<{text_width}} |" for k, t in cells]
    lines.append("")

    return lines


def main():
    try:
        grouped = collect()
    except subprocess.CalledProcessError:
        sys.exit("AeroSpace is not responding. Is AeroSpace.app running?")

    os.makedirs(os.path.dirname(ORG_PATH), exist_ok=True)
    with open(ORG_PATH, "w") as handle:
        handle.write(render_org(grouped) + "\n")

    if "--print" in sys.argv:
        print(render_text(grouped))
        return

    print(f"wrote {ORG_PATH}")


if __name__ == "__main__":
    main()
