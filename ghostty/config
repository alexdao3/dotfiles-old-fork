shell-integration = zsh
font-family = MesloLGS Nerd Font Mono
font-size = 16
background-opacity = 0.85
theme = Afterglow
macos-option-as-alt = true
mouse-hide-while-typing = true
scrollback-limit = 1000000

keybind = shift+enter=text:\x1b\r

# wipe defaults, add paste back
keybind=clear
keybind=super+v=paste_from_clipboard

# panes (leader ctrl+a + vim keys)
keybind=ctrl+a>h=goto_split:left
keybind=ctrl+a>j=goto_split:bottom
keybind=ctrl+a>k=goto_split:top
keybind=ctrl+a>l=goto_split:right

# split management
keybind=ctrl+a>shift+apostrophe=new_split:down
keybind=ctrl+a>shift+5=new_split:right
keybind=ctrl+a>a=equalize_splits

keybind=ctrl+a>f=toggle_split_zoom
keybind=ctrl+a>z=toggle_split_zoom
keybind=ctrl+a>w=close_surface

# tabs
keybind=ctrl+a>c=new_tab
keybind=ctrl+a>x=close_tab
keybind=ctrl+a>n=next_tab
keybind=ctrl+a>p=previous_tab

# fast cycling
keybind=ctrl+tab=next_tab
keybind=ctrl+shift+tab=previous_tab

